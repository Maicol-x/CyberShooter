////                                     LIT MUZZLEFLASH                                  ////

if $map.shotfired < 0.95 {
light offset 0 0 0 0 0 0
} else {
NewFlashX=$map.MuzzleFlashX
NewFlashY=$map.MuzzleFlashY
NewFlashZ=$map.MuzzleFlashZ
NewFlashX-=0.5
NewFlashY-=0.5
light offset 0 0 0 $NewFlashX $NewFlashY $NewFlashZ
map.shotfired-=$global.deltaTime
}